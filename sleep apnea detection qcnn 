        "sns.heatmap(cm_ensemble, annot=True, fmt='d', cmap='Blues', xticklabels=label_encoder.classes_, yticklabels=label_encoder.classes_, ax=ax[0])\n",
        "ax[0].set_title('Confusion Matrix - Ensemble Model')\n",
        "ax[0].set_xlabel('Predicted')\n",
        "ax[0].set_ylabel('True')\n",
        "\n",
        "sns.heatmap(cm_cnn, annot=True, fmt='d', cmap='Blues', xticklabels=label_encoder.classes_, yticklabels=label_encoder.classes_, ax=ax[1])\n",
        "ax[1].set_title('Confusion Matrix - CNN Model')\n",
        "ax[1].set_xlabel('Predicted')\n",
        "ax[1].set_ylabel('True')\n",
        "\n",
        "plt.show()\n",
        "\n",
        "# --- ROC Curve ---\n",
        "fpr_ensemble, tpr_ensemble, _ = roc_curve(y_test, final_proba)\n",
        "fpr_cnn, tpr_cnn, _ = roc_curve(y_test, cnn_proba)\n",
        "\n",
        "roc_auc_ensemble = auc(fpr_ensemble, tpr_ensemble)\n",
        "roc_auc_cnn = auc(fpr_cnn, tpr_cnn)\n",
        "\n",
        "plt.figure(figsize=(8, 6))\n",
        "plt.plot(fpr_ensemble, tpr_ensemble, color='blue', label=f'Ensemble Model (AUC = {roc_auc_ensemble:.2f})')\n",
        "plt.plot(fpr_cnn, tpr_cnn, color='orange', label=f'CNN Model (AUC = {roc_auc_cnn:.2f})')\n",
