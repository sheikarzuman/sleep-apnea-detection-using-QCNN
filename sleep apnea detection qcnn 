        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.model_selection import train_test_split, GridSearchCV\n",
        "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
        "from sklearn.decomposition import PCA\n",
        "from sklearn.linear_model import LogisticRegression\n",
        "from sklearn.ensemble import RandomForestClassifier, GradientBoostingClassifier\n",
        "from sklearn.metrics import accuracy_score, confusion_matrix, roc_curve, auc\n",
        "from sklearn.svm import SVC\n",
        "import pennylane as qml\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import Dense, Conv1D, Flatten, MaxPooling1D\n",
        "from tensorflow.keras.optimizers import Adam\n",
        "\n",
        "# Load the dataset\n",
        "data = pd.read_csv(\"/content/ecg_sleep_apnea_dataset.csv\")\n",
        "\n",
        "# Sample a fraction of the dataset\n",
        "data_sample = data.sample(frac=0.1, random_state=42)\n",
        "\n",
        "# Separate features and target\n",
        "X = data_sample.iloc[:, :-1].values\n",
        "y = data_sample['Target'].values\n",
        "\n",
        "# Encode target labels\n",
        "label_encoder = LabelEncoder()\n",
        "y_encoded = label_encoder.fit_transform(y)\n",
        "\n",
        "# Standardize features\n",
        "scaler = StandardScaler()\n",
        "X_scaled = scaler.fit_transform(X)\n",
        "\n",
        "# Apply PCA for dimensionality reduction\n",
        "n_components = 10  # You can fine-tune this based on performance\n",
        "pca = PCA(n_components=n_components)\n",
        "X_reduced = pca.fit_transform(X_scaled)\n",
        "\n",
        "# Define Quantum device for QCNN layer\n",
        "n_qubits = n_components\n",
        "dev = qml.device(\"default.qubit\", wires=n_qubits)\n",
        "\n",
        "# Define the Quantum Convolutional Layer (QCNN)\n",
        "def qcnn_layer(inputs):\n",
        "    @qml.qnode(dev)\n",
        "    def circuit(inputs):\n",
        "        # Embedding the features into the quantum state\n",
        "        qml.AmplitudeEmbedding(features=inputs, wires=range(n_qubits), pad_with=0, normalize=True)\n",
        "\n",
        "        # Apply quantum convolutional operations (e.g., Pauli rotations, CNOT gates)\n",
        "        qml.Hadamard(wires=0)\n",
        "        qml.CNOT(wires=[0, 1])\n",
        "        qml.RZ(inputs[0], wires=0)\n",
        "        qml.RY(inputs[1], wires=1)\n",
        "\n",
        "        # Measure the quantum state\n",
        "        return [qml.expval(qml.PauliZ(i)) for i in range(n_qubits)]\n",
        "\n",
        "    return circuit(inputs)\n",
        "\n",
        "# Convert data to quantum-enhanced features using the QCNN layer\n",
        "quantum_features_train = np.array([qcnn_layer(x) for x in X_reduced])\n",
        "\n",
        "# Split the dataset into training and testing sets\n",
        "X_train, X_test, y_train, y_test = train_test_split(quantum_features_train, y_encoded, test_size=0.2, random_state=42)\n",
        "\n",
        "# --- Classical Models ---\n",
        "# Logistic Regression (replacing SVM)\n",
        "svm_model = LogisticRegression(solver='lbfgs', max_iter=1000)\n",
        "svm_model.fit(X_train, y_train)\n",
        "svm_proba = svm_model.predict_proba(X_test)[:, 1]\n",
        "\n",
        "# Random Forest\n",
        "rf_model = RandomForestClassifier()\n",
        "grid_search_rf = GridSearchCV(rf_model, param_grid_rf, cv=5)\n",
        "grid_search_rf.fit(X_train, y_train)\n",
        "rf_proba = grid_search_rf.predict_proba(X_test)[:, 1]\n",
        "\n",
        "# Gradient Boosting\n",
        "gbm_model = GradientBoostingClassifier()\n",
        "grid_search_gbm = GridSearchCV(gbm_model, param_grid_gbm, cv=5)\n",
        "grid_search_gbm.fit(X_train, y_train)\n",
        "gbm_proba = grid_search_gbm.predict_proba(X_test)[:, 1]\n",
        "\n",
        "# Deep Learning Model (Neural Network)\n",
        "deep_model = Sequential([\n",
        "    Dense(64, input_dim=n_qubits, activation='relu'),\n",
        "    Dense(32, activation='relu'),\n",
        "    Dense(16, activation='relu'),\n",
        "    Dense(1, activation='sigmoid')\n",
        "])\n",
        "deep_model.compile(optimizer=Adam(), loss='binary_crossentropy', metrics=['accuracy'])\n",
        "deep_model.fit(X_train, y_train, epochs=50, batch_size=32, validation_data=(X_test, y_test))\n",
        "deep_proba = deep_model.predict(X_test).flatten()\n",
        "\n",
        "# Weighted average of the probabilities\n",
        "final_proba = svm_weight * svm_proba + rf_weight * rf_proba + gbm_weight * gbm_proba + deep_weight * deep_proba\n",
        "\n",
        "# Convert final probabilities to binary predictions\n",
        "final_predictions = (final_proba > 0.5).astype(int)\n",
        "\n",
        "# --- CNN Model (Classical CNN) ---\n",
        "cnn_model = Sequential([\n",
        "    Conv1D(32, 3, activation='relu', input_shape=(X_train.shape[1], 1)),\n",
        "    MaxPooling1D(2),\n",
        "    Flatten(),\n",
        "    Dense(64, activation='relu'),\n",
        "    Dense(1, activation='sigmoid')\n",
        "])\n",
        "\n",
        "cnn_model.compile(optimizer=Adam(), loss='binary_crossentropy', metrics=['accuracy'])\n",
        "cnn_model.fit(X_train.reshape(-1, X_train.shape[1], 1), y_train, epochs=50, batch_size=32, validation_data=(X_test.reshape(-1, X_test.shape[1], 1), y_test))\n",
        "cnn_proba = cnn_model.predict(X_test.reshape(-1, X_test.shape[1], 1)).flatten()\n",
        "cnn_predictions = (cnn_proba > 0.5).astype(int)\n",
        "\n",
        "# --- Evaluate the Performance of Models ---\n",
        "final_accuracy = accuracy_score(y_test, final_predictions)\n",
        "cnn_accuracy = accuracy_score(y_test, cnn_predictions)\n",
        "\n",
        "# --- Accuracy Comparison Plot ---\n",
        "plt.figure(figsize=(8, 6))\n",
        "models = ['Ensemble Model', 'CNN Model']\n",
        "accuracies = [final_accuracy, cnn_accuracy]\n",
        "plt.bar(models, accuracies, color=['blue', 'orange'])\n",
        "plt.xlabel('Model')\n",
        "plt.ylabel('Accuracy')\n",
        "plt.title('Accuracy Comparison: Ensemble Model vs CNN')\n",
        "plt.show()\n",
