        "cnn_model.compile(optimizer=Adam(), loss='binary_crossentropy', metrics=['accuracy'])\n",
        "cnn_model.fit(X_train.reshape(-1, X_train.shape[1], 1), y_train, epochs=50, batch_size=32, validation_data=(X_test.reshape(-1, X_test.shape[1], 1), y_test))\n",
        "cnn_proba = cnn_model.predict(X_test.reshape(-1, X_test.shape[1], 1)).flatten()\n",
        "cnn_predictions = (cnn_proba > 0.5).astype(int)\n",
